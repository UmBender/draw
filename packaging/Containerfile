# Build image for scripts/package.sh (ADR-T27-1): glibc 2.28, so the
# packaged binary starts on RHEL 8, Debian 10, Ubuntu 20.04 and newer.
FROM docker.io/library/almalinux:8

RUN dnf -y install gcc binutils findutils tar gzip curl \
        desktop-file-utils libappstream-glib \
    && dnf clean all

ARG RUST_VERSION=1.97.0
ARG CARGO_DEB_VERSION=3.8.0
ARG CARGO_GENERATE_RPM_VERSION=0.21.0

ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain "$RUST_VERSION" \
    && cargo install --locked cargo-deb --version "$CARGO_DEB_VERSION" \
    && cargo install --locked cargo-generate-rpm --version "$CARGO_GENERATE_RPM_VERSION" \
    && rm -rf /opt/cargo/registry
